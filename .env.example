# ─── Base de datos ────────────────────────────────────────────────────────────
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/lensinvoice"

# ─── Autenticación (NextAuth) ─────────────────────────────────────────────────
# Genera un secreto seguro con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-seguro-de-al-menos-32-caracteres"

# URL pública de la aplicación (sin barra al final)
AUTH_URL="https://tudominio.com"
